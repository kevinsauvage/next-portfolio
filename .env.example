# Runtime server-only variables (read by the contact form server action).
# Never prefix these with NEXT_PUBLIC_ — they would leak to the browser.
email_js_service_id=your_emailjs_service_id
email_js_public_key=your_emailjs_public_key
email_js_private_key=your_emailjs_private_key
email_js_template_id=your_emailjs_template_id
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# Build-time public variables (inlined into the client bundle by `next build`).
# Changing these requires a rebuild — they are not read at runtime.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
NEXT_PUBLIC_UMAMI_ENABLE_IN_DEV=false
# Sentry client trace sampling (0–1). Defaults to 0.1.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Runtime public variables (read server-side and passed to the client as props).
UMAMI_ID=your_umami_website_id
UMAMI_DOMAINS=yourdomain.com

# Runtime server-only (optional).
GOOGLE_SITE_VERIFICATION=your_google_verification_token
# Sentry server/edge trace sampling (0–1). Defaults to 0.1.
SENTRY_TRACES_SAMPLE_RATE=0.1

# Build-time only (optional): uploads source maps to Sentry.
# Set this in Vercel/CI, not in your local app runtime.
SENTRY_AUTH_TOKEN=your_sentry_auth_token
