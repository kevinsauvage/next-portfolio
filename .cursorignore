# Cursor agent/index access — .gitignore syntax.
# Secrets are also in Cursor's built-in default ignore list; listing them here
# makes the intent explicit and survives changes to that default.
.env*
!.env.example
.env.sentry-build-plugin

# Build & test artefacts (regenerated by npm scripts — never worth indexing)
.next/
out/
build/
dist/
coverage/
playwright-report/
blob-report/
test-results/
*.tsbuildinfo
.vercel/

# Generated context graph (regenerable via `graft build`) — see .ignore
graft/
