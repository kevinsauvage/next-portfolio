{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "docs/design-system.md"],
  "permission": {
    "edit": {
      "*": "allow",
      ".env": "deny",
      ".env.local": "deny",
      ".env.*.local": "deny",
      ".env.example": "allow"
    },
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow",
      "npm run check": "allow",
      "npm run type-check": "allow",
      "npm run lint": "allow",
      "npm run format:check": "allow",
      "npm run test:run*": "allow",
      "npm run test:coverage*": "allow",
      "npx vitest run*": "allow",
      "npm run build": "allow"
    },
    "external_directory": "ask",
    "webfetch": "allow",
    "websearch": "allow"
  },
  "agent": {
    "reviewer": {
      "description": "Reviews the current diff for correctness, security and missing tests. Read-only.",
      "mode": "subagent",
      "prompt": "You are a code reviewer. Review the working-tree diff for correctness, security (secrets, XSS, CSP), accessibility regressions, and missing colocated tests. Report findings in severity order with file:line references. Do not edit files.",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow"
        }
      }
    }
  }
}
