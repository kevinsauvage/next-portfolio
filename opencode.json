{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "docs/design-system.md"],
  "permission": {
    "edit": {
      "*": "allow",
      ".env": "deny",
      ".env.local": "deny",
      ".env.*.local": "deny",
      ".env.example": "allow"
    },
    "bash": {
      "*": "allow",
      "cat*.env*": "deny",
      "head*.env*": "deny",
      "tail*.env*": "deny",
      "cat*.env.example*": "allow",
      "head*.env.example*": "allow",
      "tail*.env.example*": "allow",
      "find*-delete*": "deny",
      "find*-exec*": "deny",
      "sed*-i*": "deny",
      "sed*--in-place*": "deny"
    },
    "external_directory": "ask",
    "webfetch": "allow",
    "websearch": "allow"
  },
  "agent": {
    "reviewer": {
      "description": "Reviews the current diff for correctness, security and missing tests. Read-only.",
      "mode": "subagent",
      "prompt": "You are a code reviewer. Review the working-tree diff for correctness, security (secrets, XSS, CSP), accessibility regressions, and missing colocated tests. Report findings in severity order with file:line references. Do not edit files.",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow"
        }
      }
    }
  }
}
